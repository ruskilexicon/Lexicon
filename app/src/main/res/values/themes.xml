<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lexicon" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#365F3B</item>
        <item name="android:windowBackground">@color/lexicon_background</item>
        <item name="android:statusBarColor">@color/lexicon_background</item>
        <item name="android:navigationBarColor">@color/lexicon_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
